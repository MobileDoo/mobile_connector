#. module: mobile_connector
#. odoo-python
#: code:addons/mobile_connector/models/mobile_push_fcm.py:0
msgid "Firebase accepted no device (%s). Open the app on the phone once more so it registers again."
msgstr "Firebase không nhận thiết bị nào (%s). Hãy mở lại app trên điện thoại để đăng ký lại."

#. module: mobile_connector
#. odoo-python
