#: code:addons/mobile_connector/models/res_config_settings.py:0
msgid "%(usage)s."
msgstr "%(usage)s."

#. module: mobile_connector
#. odoo-python
#: code:addons/mobile_connector/models/res_config_settings.py:0
msgid ""
"%(usage)s: more than the %(seats)s seats of the subscription. Contact the provider to extend it."
msgstr ""
"%(usage)s: nhiều hơn %(seats)s suất của gói đăng ký. Hãy liên hệ nhà cung cấp để nâng gói."

#. module: mobile_connector
#. odoo-python
#: code:addons/mobile_connector/models/res_config_settings.py:0
msgid ""
"%(usage)s, every seat (%(seats)s) is used: accounts that did not receive any yet are refused. Contact the provider to extend the subscription."
msgstr ""
"%(usage)s, đã dùng hết %(seats)s suất: tài khoản chưa từng nhận thông báo sẽ bị từ chối. Hãy liên hệ nhà cung cấp để nâng gói."

#. module: mobile_connector
#. odoo-python
#: code:addons/mobile_connector/models/res_config_settings.py:0
msgid ""
"Not checked yet: the gateway reports once a day, or press \"Check now\"."
msgstr ""
"Chưa kiểm tra: gateway báo mỗi ngày một lần, hoặc bấm \"Kiểm tra ngay\"."

#. module: mobile_connector
#. odoo-python
#: code:addons/mobile_connector/models/res_config_settings.py:0
msgid ""
"The subscription of this site is suspended: notifications are not sent. Contact the provider of the push gateway."
msgstr ""
"Gói đăng ký của hệ thống này đang bị tạm ngưng: thông báo không được gửi. Hãy liên hệ nhà cung cấp push gateway."

#. module: mobile_connector
#. odoo-python
#: code:addons/mobile_connector/models/res_config_settings.py:0
msgid "Set the push gateway address and site token first."
msgstr "Hãy nhập địa chỉ và site token của push gateway trước."

#. module: mobile_connector
#. odoo-python
#: code:addons/mobile_connector/models/res_config_settings.py:0
