msgstr "Kết nối ứng dụng"

#. module: mobile_connector
#: model_terms:ir.ui.view,arch_db:mobile_connector.res_config_settings_view_form
msgid "Server address"
msgstr "Địa chỉ máy chủ"

#. module: mobile_connector
#: model_terms:ir.ui.view,arch_db:mobile_connector.res_config_settings_view_form
msgid ""
"Users scan this QR code on the first screen of the app (Scan QR code) "
"instead of typing the address. Print it or show it on a screen; it contains "
"the address and the database, no password."
msgstr ""
"Người dùng quét mã QR này ở màn hình đầu tiên của ứng dụng (Quét mã QR) thay "
"vì gõ địa chỉ. Có thể in ra hoặc chiếu lên màn hình; mã chỉ chứa địa chỉ và "
"database, không chứa mật khẩu."

#. module: mobile_connector
#: model:ir.model.fields,field_description:mobile_connector.field_res_config_settings__mobile_public_url
msgid "Server address for the app"
msgstr "Địa chỉ máy chủ cho ứng dụng"

#. module: mobile_connector
#: model:ir.model.fields,help:mobile_connector.field_res_config_settings__mobile_public_url
msgid ""
"Address the phones use to reach this Odoo, e.g. https://erp.example.com. "
"Empty: the web base URL."
msgstr ""
"Địa chỉ điện thoại dùng để truy cập Odoo này, ví dụ https://erp.example.com. "
"Để trống: dùng địa chỉ web của Odoo."

#. module: mobile_connector
#: model:ir.model.fields,field_description:mobile_connector.field_res_config_settings__mobile_connect_qr
msgid "Connect QR code"
msgstr "Mã QR kết nối"

