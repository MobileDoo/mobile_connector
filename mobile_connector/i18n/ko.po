#. module: mobile_connector
#: model:ir.model.fields,help:mobile_connector.field_ir_ui_menu__mobile_hide
msgid ""
"Do not show this menu (and its sub-menus) in the \"Odoo apps\" section of the mobile app."
msgstr "모바일 앱의 \"Odoo 앱\" 섹션에 이 메뉴(및 하위 메뉴)를 표시하지 않습니다."

