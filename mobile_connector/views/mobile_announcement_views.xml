<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mobile_announcement_view_tree" model="ir.ui.view">
        <field name="name">mobile.announcement.tree</field>
        <field name="model">mobile.announcement</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="locked"/>
                <field name="dismissed_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="mobile_announcement_view_form" model="ir.ui.view">
        <field name="name">mobile.announcement.form</field>
        <field name="model">mobile.announcement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Tet holiday schedule"/></h1>
                    </div>
                    <field name="body" placeholder="Text shown in the app. Web addresses become links." nolabel="1"/>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="locked"/>
                            <field name="icon"/>
                            <field name="color"/>
                            <field name="dismissed_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mobile_announcement_action" model="ir.actions.act_window">
        <field name="name">Mobile Announcements</field>
        <field name="res_model">mobile.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Post an announcement on the home screen of the app</p>
            <p>Choose who gets it (groups) and when. Users dismiss it once read, unless it is mandatory.</p>
        </field>
    </record>
</odoo>
