<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mobile_push_message_view_tree" model="ir.ui.view">
        <field name="name">mobile.push.message.tree</field>
        <field name="model">mobile.push.message</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'failed'" decoration-muted="state == 'skipped'" decoration-warning="state == 'queued'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="title"/>
                <field name="body"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="queued_at" optional="hide"/>
                <field name="error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mobile_push_message_action" model="ir.actions.act_window">
        <field name="name">Push Messages</field>
        <field name="res_model">mobile.push.message</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
