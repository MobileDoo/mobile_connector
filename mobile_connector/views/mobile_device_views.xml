<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mobile_device_view_tree" model="ir.ui.view">
        <field name="name">mobile.device.tree</field>
        <field name="model">mobile.device</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="user_id"/>
                <field name="name"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="last_seen"/>
                <button name="action_revoke" type="object" string="Revoke" icon="fa-ban"/>
            </list>
        </field>
    </record>

    <record id="mobile_device_view_search" model="ir.ui.view">
        <field name="name">mobile.device.search</field>
        <field name="model">mobile.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="name"/>
                <filter name="inactive" string="Revoked" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mobile_device_action" model="ir.actions.act_window">
        <field name="name">Mobile Devices</field>
        <field name="res_model">mobile.device</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
